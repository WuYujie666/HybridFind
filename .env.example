# HybridFind configuration (optional)
# HYBRIDFIND_BM25_WEIGHT=0.5
# HYBRIDFIND_VECTOR_WEIGHT=0.5
# HYBRIDFIND_TOP_K=10

# HuggingFace model loading
# HF_HUB_OFFLINE=1          # Force offline mode: only load from local cache, no network (default)
# HF_HUB_OFFLINE=0          # Allow downloading models from HuggingFace when not cached locally
# HF_ENDPOINT=https://hf-mirror.com  # Use a mirror endpoint for downloading models (e.g. China mainland)
